# Copy to .env and fill in. .env is gitignored; this template is tracked.
# Docker Compose reads .env automatically.
#
# Generate passwords with:
#   python -c "import secrets,string; a=string.ascii_letters+string.digits; \
#              print(''.join(secrets.choice(a) for _ in range(32)))"
# Use alphanumerics only — '$' triggers Compose variable expansion and '#'
# starts a comment, both of which silently corrupt the value.

# --- Tier A: PostgreSQL (reference + macro vintages) ---
POSTGRES_DB=fxpit
POSTGRES_USER=fxpit_admin
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Tier B: ClickHouse (ticks + bars) ---
CLICKHOUSE_DB=fxpit
CLICKHOUSE_USER=fxpit_admin
CLICKHOUSE_PASSWORD=
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# --- ALFRED / FRED API key (OPTIONAL) ---
# Free but requires an account, which violates the project's no-registration
# constraint. ALFRED is therefore an OPTIONAL enrichment source: the pipeline
# must still run to completion with this unset. Philadelphia Fed RTDSM stays
# the primary vintage source.
# Get one at https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# --- Tier C: DuckDB (research query layer, in-process) ---
DUCKDB_PATH=data/research.duckdb

# --- Local data root (gitignored) ---
# Raw downloads, Parquet exports, ingest ledger artefacts.
DATA_ROOT=data
