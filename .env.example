# Copy to .env and adjust. .env is gitignored.
# Docker Compose reads this file automatically.

# --- Tier A: PostgreSQL (reference + macro vintages) ---
POSTGRES_DB=fx
POSTGRES_USER=fx
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Tier B: ClickHouse (ticks + bars) ---
CLICKHOUSE_DB=fx
CLICKHOUSE_USER=fx
CLICKHOUSE_PASSWORD=changeme
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# --- Tier C: DuckDB (research query layer, in-process) ---
DUCKDB_PATH=data/research.duckdb

# --- Local data root (gitignored) ---
# Raw downloads, Parquet exports, ingest ledger artefacts.
DATA_ROOT=data
